rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Reglas de producción — Sistema de Muestristas · Deportivos Quini
//
// Identidad: Firebase Authentication (Email/Password), una cuenta fija por
// empleado. Cada cuenta se mapea a su rol de negocio vía el documento de
// SOLO LECTURA usuarios/{authUid} = { empleadoId, rol }, creado una sola vez
// a mano desde la consola de Firebase — nunca lo escribe el cliente, para
// que nadie pueda auto-asignarse un rol.
//
// El login en la app sigue siendo "elige tu ícono + tu PIN de 6 dígitos":
// el PIN es literalmente la contraseña de esa cuenta de Firebase Auth, así
// que la verificación ya no pasa por Firestore ni por el cliente — la hace
// el servidor de Identity Platform de Google (con su propio rate limiting
// contra fuerza bruta). Antes de esta versión, la identidad se declaraba
// en el propio payload del cliente (uid en la ruta del documento o en
// request.resource.data) y no había forma de verificarla — cualquiera con
// el SDK de Firestore y el apiKey público podía leer/escribir como
// cualquier usuario. Con request.auth.uid verificado por Google, eso ya
// no es posible.
//
// ALCANCE DE CADA ROL (definido 2026-08-07):
//   · Muestrista — ve ÚNICAMENTE lo suyo: los desarrollos donde él es el
//     `asignado_a` y las capturas donde él es el `id_muestrista`. No ve el
//     trabajo de su compañero ni el dashboard comparativo.
//   · Admin (Lety) — ve todo: asigna, revisa, aprueba y es la única que abre
//     el dashboard, el catálogo y las exportaciones.
//
//   Por qué NO se copió el modelo de la app hermana (captura-mecanicos):
//   allá las incidencias son una cola compartida y cualquier mecánico debe
//   poder verlas todas para tomar la que le toque. Aquí no hay cola: Lety
//   asigna nominalmente, así que la lectura amplia no compraba nada y solo
//   exponía el trabajo ajeno.
//
// LA ASIGNACIÓN ES PERMANENTE. `asignado_a` (desarrollos) e `id_muestrista`
// (capturas) son inmutables, y la segmentación de lectura de arriba depende
// de eso. Si algún día se quiere permitir reasignar o cubrir una ausencia,
// NO basta con volver mutable `asignado_a`: el dueño anterior conservaría
// sus capturas y el nuevo vería el desarrollo sin poder continuarlas, y se
// podría duplicar la ficha de una variante ya capturada. Ese traspaso tiene
// que resolver las capturas abiertas y preservar la autoría histórica (las
// métricas por muestrista se calculan sobre `id_muestrista`).
//
// Despliegue:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ──
    function autenticado() {
      return request.auth != null;
    }
    function usuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    // Baja de personal sin borrar la cuenta: `activo: false` en el perfil
    // corta el acceso en la siguiente petición, sin esperar a que expire el
    // ID token. El default es `true` a propósito — los tres perfiles actuales
    // se crearon a mano antes de que existiera el campo y `usuarios` tiene
    // `allow write: if false`, así que no se pueden migrar desde la app: un
    // default `false` dejaría fuera a todo el mundo en el instante del deploy.
    // Campo ausente = perfil legacy = activo. Si se llega a poblar `activo`
    // en los tres perfiles desde la consola, conviene cambiar el default a
    // `false` (más seguro). IMPORTANTE al desactivar desde la consola de
    // Firebase: el campo debe ser de tipo booleano, no el string "false" —
    // un valor mal tipado también bloquea el acceso (falla el `is bool`),
    // pero es mucho más confuso de diagnosticar que un rechazo limpio.
    function activoOk() {
      return usuarioDoc().data.get('activo', true) is bool
        && usuarioDoc().data.get('activo', true) == true;
    }
    function tieneUsuarioActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && activoOk();
    }
    function miEmpleadoId() {
      return usuarioDoc().data.empleadoId;
    }
    function esAdmin() {
      return tieneUsuarioActivo() && usuarioDoc().data.rol == 'admin';
    }
    function esMuestristaActual() {
      return tieneUsuarioActivo() && usuarioDoc().data.rol == 'muestrista';
    }

    // ── Helpers de datos (validación de forma, igual que antes) ──
    // Un campo vacío se puede llenar; uno que YA tiene valor queda congelado.
    // Es lo que permite agregar la OT después sin abrir la puerta a reescribir
    // el modelo o el cliente de una tarea que el muestrista ya está trabajando.
    function soloSeCompleta(campo) {
      return resource.data.get(campo, '') == ''
        || request.resource.data.get(campo, '') == resource.data.get(campo, '');
    }
    // Igual que soloSeCompleta, pero exigiendo forma. Estos campos se
    // congelan en cuanto se llenan y NO hay ningún camino para corregirlos
    // después, así que un valor mal tipado (un número donde va la OT) sería
    // permanente.
    function completaTexto(campo, largo) {
      return soloSeCompleta(campo)
        && request.resource.data.get(campo, '') is string
        && request.resource.data.get(campo, '').size() <= largo;
    }
    function esMuestristaId(id) {
      return id in ['israel', 'jesus'];
    }
    function estadoCapturaValido(e) {
      return e in ['activo', 'pausado', 'pendiente_lety', 'correccion', 'aprobado'];
    }
    // Los estados válidos de un desarrollo son 'pendiente', 'en_proceso' y
    // 'terminado', pero cada transición vive en su propia rama del `update`
    // de /desarrollos (ver abajo). Aquí solo se valida el nacimiento: una
    // tarea siempre arranca pendiente, nunca ya terminada.
    // Firma: ausente, null, o data-URL PNG bien formado (la app solo
    // renderiza este formato; bloquea payloads de XSS almacenado)
    function firmaOk(data, campo) {
      return !(campo in data) || data[campo] == null
        || (data[campo] is string
            && data[campo].size() < 300000
            && data[campo].matches('data:image/png;base64,[A-Za-z0-9+/=]+'));
    }
    // Complejidad por variante: map {codigo: 'A'|'B'|'C'} en el doc privado.
    // El campo es opcional (los desarrollos viejos no lo traen). Se valida que
    // las llaves sean códigos REALES de este desarrollo, leyéndolos del
    // documento público. Se usa getAfter porque en el alta ese documento nace
    // en el mismo batch; en un update devuelve lo mismo que get.
    // Los VALORES no se pueden validar aquí: las reglas no iteran maps.
    function complejidadPorCodigoOk(devId) {
      return !('complejidad_por_codigo' in request.resource.data)
        || (request.resource.data.complejidad_por_codigo is map
            && request.resource.data.complejidad_por_codigo.keys().size() <= 40
            && request.resource.data.complejidad_por_codigo.keys().hasOnly(
                 getAfter(/databases/$(database)/documents/desarrollos/$(devId)).data.variante_codigos));
    }
    // Tiempos coherentes: números no negativos, TM nunca mayor que el bruto
    function tiemposOk(data) {
      return data.elapsed_seg is number && data.tm_seg is number
        && data.elapsed_seg >= 0 && data.tm_seg >= 0
        && data.tm_seg <= data.elapsed_seg
        && (!('tm_causas' in data) || data.tm_causas is map);
    }

    // ── usuarios: mapa authUid -> {empleadoId, rol}. Cada cuenta solo lee
    // su propio doc; la creación/edición es manual desde la consola.
    match /usuarios/{authUid} {
      allow read: if autenticado() && request.auth.uid == authUid;
      allow write: if false;
    }

    // ── desarrollos: tareas que Lety asigna ──
    match /desarrollos/{devId} {
      // Lety ve todos; cada muestrista solo los suyos. Como las reglas NO
      // filtran, toda consulta de lista del muestrista debe traer su propio
      // where('asignado_a','==',...) o Firestore la rechaza entera
      // (ver muestrista.js y captura.js).
      allow read: if esAdmin()
                  || (esMuestristaActual() && resource.data.asignado_a == miEmpleadoId());
      allow create: if esAdmin()
                    && request.resource.data.modelo is string
                    && request.resource.data.modelo.size() > 0
                    && esMuestristaId(request.resource.data.asignado_a)
                    && request.resource.data.estado == 'pendiente'
                    && !('tipo_complejidad' in request.resource.data)
                    && existsAfter(/databases/$(database)/documents/desarrollos_privado/$(devId))
                    // OJO: las reglas no pueden inspeccionar los elementos de
                    // una lista, así que aquí NO se puede impedir que una
                    // variante traiga dentro su `complejidad`. Ese dato es
                    // secreto (el muestrista lee este documento completo) y el
                    // único candado real está en el cliente: `asignar()` lo
                    // separa hacia desarrollos_privado antes de escribir. Si
                    // tocas asignar(), no quites ese filtrado.
                    && request.resource.data.variantes is list
                    && request.resource.data.variantes.size() > 0
                    && request.resource.data.variante_codigos is list
                    && request.resource.data.variante_codigos.size() > 0
                    && request.resource.data.creado_por == miEmpleadoId();
      // Máquina de estados del desarrollo (la "tarea"):
      //
      //   pendiente --muestrista inicia su 1ª captura--> en_proceso
      //   en_proceso --Lety aprueba el último código---> terminado
      //   terminado  --Lety reabre una ficha aprobada--> en_proceso
      //
      // Cada transición es su propia rama, atada al rol que puede hacerla.
      // NO basta con `esAdmin() || esMuestristaDueño()` + hasOnly: eso dejaría
      // al muestrista declarar terminada su propia tarea sin que Lety apruebe
      // nada (y el cierre alimenta las métricas de tiempo por tarea).
      // Los campos sensibles quedan congelados por el hasOnly de cada rama.
      allow update: if
        // ── El muestrista dueño solo arranca la tarea al iniciar una captura.
        (esMuestristaActual()
         && miEmpleadoId() == resource.data.asignado_a
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
         && resource.data.estado in ['pendiente', 'en_proceso']
         && request.resource.data.estado == 'en_proceso')
        // ── Lety mueve entre pendiente y en_proceso. Exige el estado de
        // ORIGEN: sin eso se podría saltar de 'terminado' a 'en_proceso' por
        // aquí, esquivando la rama de reapertura y dejando un `terminado_en`
        // viejo en una tarea que ya no está cerrada.
        || (esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && resource.data.estado in ['pendiente', 'en_proceso']
            && request.resource.data.estado in ['pendiente', 'en_proceso'])
        // ── Lety cierra la tarea. El sello de tiempo lo pone el servidor
        // (serverTimestamp() == request.time), no el cliente: es la medida de
        // cuánto tardó la tarea completa.
        || (esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'terminado_en'])
            && resource.data.estado == 'en_proceso'
            && request.resource.data.estado == 'terminado'
            && request.resource.data.terminado_en == request.time)
        // ── Lety reabre una tarea cerrada (rechazó una ficha ya aprobada):
        // el sello se limpia para que no quede una fecha de cierre mentirosa.
        || (esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'terminado_en'])
            && resource.data.estado == 'terminado'
            && request.resource.data.estado == 'en_proceso'
            && request.resource.data.get('terminado_en', null) == null)
        // ── Lety AMPLÍA una tarea ya asignada. Es la única rama que toca algo
        // más que el estado, y existe por dos casos reales del negocio:
        //   · La OT no existe cuando se crea la tarea — se genera después,
        //     cuando la muestra se sube al ERP.
        //   · Un pack de 6 se vuelve de 12 si el cliente pide derecho e
        //     izquierdo a media marcha.
        // SOLO AGREGA, nunca modifica:
        //   · `variante_codigos` y `variantes` solo pueden CRECER por el
        //     final: su prefijo debe quedar idéntico. Así una variante ya
        //     capturada no puede desaparecer, cambiar de nombre ni que le
        //     reescriban los pares, que es lo que rompería el vínculo con
        //     sus capturas.
        //   · Los datos del pedido solo pueden pasar de vacío a lleno.
        //   · `estado`, `asignado_a`, `modelo`, `cliente` y `creado_por` no
        //     están en el hasOnly, así que quedan congelados.
        // LÍMITE CONOCIDO: las reglas no pueden contar elementos únicos de una
        // lista, así que un código DUPLICADO en variante_codigos pasaría este
        // filtro. No es una fuga (solo el admin escribe aquí) pero sí ensucia
        // la tarea: el cliente lo valida antes de escribir.
        // ── Lety COMPLETA datos que faltaban (rama sin variantes).
        // Va aparte de la ampliación a propósito: si compartieran rama, cada
        // vez que Lety llenara la OT se re-evaluaría la unicidad de
        // `variante_codigos`, y una tarea vieja con un código repetido
        // quedaría bloqueada para siempre sin que nadie entienda por qué.
        || (esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ot', 'po', 'codigo_quini', 'notas', 'agujado', 'tipo_producto', 'talla', 'genero'])
            && completaTexto('ot', 40) && completaTexto('po', 40)
            && completaTexto('codigo_quini', 60) && completaTexto('agujado', 10)
            && completaTexto('tipo_producto', 120) && completaTexto('talla', 40)
            && completaTexto('genero', 40) && completaTexto('notas', 500))
        // ── Lety AGREGA variantes (rama sin datos del pedido).
        || (esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['variantes', 'variante_codigos'])
            && request.resource.data.variantes is list
            && request.resource.data.variante_codigos is list
            && request.resource.data.variante_codigos.size() > resource.data.variante_codigos.size()
            && request.resource.data.variante_codigos.size() <= 40
            // APPEND-ONLY DE VERDAD: el prefijo debe ser IDÉNTICO al de antes.
            // `hasAll` no bastaba — dejaba reordenar la lista, duplicar un
            // código para inflar el tamaño, y no protegía los objetos de
            // `variantes` (se podía reescribir la descripción o los pares de
            // una variante que el muestrista ya está capturando).
            && request.resource.data.variante_codigos[0:resource.data.variante_codigos.size()]
                 == resource.data.variante_codigos
            && request.resource.data.variantes[0:resource.data.variantes.size()]
                 == resource.data.variantes
            // Sin códigos repetidos: son la identidad de cada ficha
            && request.resource.data.variante_codigos.toSet().size()
                 == request.resource.data.variante_codigos.size()
            && request.resource.data.variantes.size() == request.resource.data.variante_codigos.size());
      allow delete: if false;
    }

    // ── desarrollos_privado: datos exclusivos de admin (tipo_complejidad).
    // Documento espejo 1:1 de desarrollos/{devId}, mismo id, creado junto
    // con el público en el mismo batch (ver admin.js asignar()).
    // Desde 2026-08-10 guarda DOS cosas: `tipo_complejidad` (la del desarrollo
    // completo, que se conserva) y `complejidad_por_codigo`, un map
    // {codigo: 'A'|'B'|'C'} con la complejidad de cada variante del pack.
    //
    // LÍMITE CONOCIDO: las reglas no pueden iterar un map, así que NO se puede
    // validar aquí que cada valor sea A/B/C — solo que las llaves sean códigos
    // reales de este desarrollo (contra el doc público) y que el map no crezca
    // sin control. Los valores los valida el cliente. Es aceptable porque la
    // única que escribe aquí es Lety (admin), no un rol de piso.
    match /desarrollos_privado/{devId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.data.keys().hasOnly(['tipo_complejidad', 'complejidad_por_codigo'])
                    && request.resource.data.tipo_complejidad in ['A', 'B', 'C']
                    && complejidadPorCodigoOk(devId)
                    && existsAfter(/databases/$(database)/documents/desarrollos/$(devId));
      // Sigue siendo inmutable: hoy la app no tiene forma de editar un
      // desarrollo ya asignado (ni el público ni este), así que abrir `update`
      // solo ampliaría la superficie de escritura sin que nadie la use. Si
      // algún día se agrega "corregir complejidad" en la vista de Lety, esta
      // regla se abre JUNTO con esa pantalla, no antes.
      // Se abre SOLO para el caso de ampliar la tarea: cuando Lety agrega
      // variantes nuevas, cada una necesita su complejidad. Igual que arriba,
      // solo se AGREGA: las llaves viejas deben seguir todas presentes, así
      // que no se puede reescribir la complejidad de un código ya trabajado
      // (ese dato alimenta los puntos del muestrista).
      // Solo se AGREGAN complejidades de códigos nuevos. `hasAll` sobre las
      // llaves no bastaba: conservaba los códigos viejos pero dejaba cambiar
      // su VALOR en la misma escritura, y esa letra alimenta los puntos del
      // muestrista. Con MapDiff se exige que ninguna llave se retire ni
      // cambie, y que al menos una se agregue.
      // Bonus: `values().hasOnly()` sí puede validar los valores de un map
      // (lo que no se podía hacer en el `create`, donde el límite documentado
      // sigue vigente porque ahí no hay un mapa previo con el que comparar).
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complejidad_por_codigo'])
                    && request.resource.data.complejidad_por_codigo is map
                    && request.resource.data.complejidad_por_codigo.keys().size() <= 40
                    && request.resource.data.complejidad_por_codigo.values().hasOnly(['A', 'B', 'C'])
                    && request.resource.data.complejidad_por_codigo
                         .diff(resource.data.get('complejidad_por_codigo', {})).removedKeys().size() == 0
                    && request.resource.data.complejidad_por_codigo
                         .diff(resource.data.get('complejidad_por_codigo', {})).changedKeys().size() == 0
                    && request.resource.data.complejidad_por_codigo.keys().hasOnly(
                         getAfter(/databases/$(database)/documents/desarrollos/$(devId)).data.variante_codigos);
      allow delete: if false;
    }

    // ── fichas técnicas (subcolección PRIVADA de cada desarrollo) ──
    // Son los valores OBJETIVO que Lety importa del Excel corporativo
    // (F.T.T.): medidas con tolerancia, giros, velocidades, pesos, punto de
    // máquina, materiales.
    //
    // Solo las lee el admin, A PROPÓSITO: la captura del muestrista debe ser
    // ciega. Si el objetivo viajara a su dispositivo, podría leerlo con las
    // herramientas del navegador y capturar el número esperado en vez del que
    // midió — y la comparación dejaría de significar nada. Por eso la
    // comparación objetivo-vs-real se hace en la pantalla de revisión de
    // Lety, que sí puede leer ambos documentos.
    //
    // Inmutables: cambiar un objetivo después de una captura reescribiría el
    // pasado (una ficha aprobada pasaría a estar "fuera de tolerancia" sin que
    // nadie tocara la medición). Una corrección se sube como desarrollo nuevo.
    match /desarrollos_privado/{devId}/fichas_tecnicas/{codigo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.data.codigo == codigo
                    && request.resource.data.id_desarrollo == devId
                    && codigo.size() > 0 && codigo.size() <= 60
                    // La ficha debe ser de una variante REAL de esta tarea:
                    // sin esto se podía colgar una ficha técnica de un código
                    // ajeno al desarrollo.
                    && codigo in getAfter(/databases/$(database)/documents/desarrollos/$(devId)).data.variante_codigos;
      allow update, delete: if false;
    }

    // ── capturas: fichas prácticas (una por variante) ──
    match /capturas/{capId} {
      // Misma segmentación que desarrollos: Lety todo, el muestrista solo sus
      // fichas. El dashboard comparativo por muestrista es exclusivo de Lety.
      allow read: if esAdmin()
                  || (esMuestristaActual() && resource.data.id_muestrista == miEmpleadoId());
      allow create: if esMuestristaActual()
                    && request.resource.data.id_muestrista == miEmpleadoId()
                    && request.resource.data.id_desarrollo is string
                    && request.resource.data.codigo_variante is string
                    && request.resource.data.estado == 'activo'
                    && tiemposOk(request.resource.data)
                    && firmaOk(request.resource.data, 'firma_m')
                    && firmaOk(request.resource.data, 'firma_l')
                    // Las firmas deben nacer vacías: si no, un muestrista
                    // podría crear su ficha con firma_l (aprobación de Lety)
                    // ya puesta — bomba latente que se aprueba sola después.
                    && request.resource.data.get('firma_l', null) == null
                    && request.resource.data.get('firma_m', null) == null
                    // Folio consecutivo obligatorio, amarrado al contador que
                    // la MISMA transacción deja actualizado (getAfter)
                    && request.resource.data.folio is string
                    && request.resource.data.folio.matches('^FP-[0-9]{5,}$')
                    && request.resource.data.folio_seq is int
                    && request.resource.data.folio_seq > 0
                    // El texto del folio debe corresponder al número real del
                    // contador (tolera ceros a la izquierda, no los exige):
                    // sin esto, alguien podría crear folio_seq:2 con
                    // folio:"FP-00001" y falsificar el folio impreso.
                    && request.resource.data.folio.matches('^FP-0*' + string(request.resource.data.folio_seq) + '$')
                    && getAfter(/databases/$(database)/documents/contadores/capturas).data.seq == request.resource.data.folio_seq
                    // Cierra el hueco de atomicidad: exige que el contador
                    // haya estado exactamente en folio_seq-1 ANTES de esta
                    // operación (o no existiera, si folio_seq==1) — no basta
                    // con que el valor final (getAfter) cuadre.
                    && ((!exists(/databases/$(database)/documents/contadores/capturas) && request.resource.data.folio_seq == 1)
                        || (exists(/databases/$(database)/documents/contadores/capturas)
                            && get(/databases/$(database)/documents/contadores/capturas).data.seq == request.resource.data.folio_seq - 1))
                    // El dueño de la captura debe ser el mismo empleado
                    // asignado al desarrollo, y la variante debe pertenecer
                    // realmente a ese desarrollo (evita fichas fraudulentas)
                    && get(/databases/$(database)/documents/desarrollos/$(request.resource.data.id_desarrollo)).data.asignado_a == miEmpleadoId()
                    && request.resource.data.codigo_variante in get(/databases/$(database)/documents/desarrollos/$(request.resource.data.id_desarrollo)).data.variante_codigos
                    // No se abren fichas de una tarea ya cerrada: si Lety la
                    // dio por terminada, primero tiene que reabrirla. Si no,
                    // una captura nueva quedaría colgando de una tarea muerta.
                    && get(/databases/$(database)/documents/desarrollos/$(request.resource.data.id_desarrollo)).data.get('estado', '') != 'terminado';
      allow update: if estadoCapturaValido(request.resource.data.estado)
                    // El dueño, el desarrollo de origen y la variante no se reasignan
                    && request.resource.data.id_muestrista == resource.data.id_muestrista
                    && request.resource.data.id_desarrollo == resource.data.id_desarrollo
                    && request.resource.data.get('codigo_variante', '') == resource.data.get('codigo_variante', '')
                    // El folio no se puede cambiar ni borrar una vez asignado
                    && request.resource.data.get('folio', '') == resource.data.get('folio', '')
                    && request.resource.data.get('folio_seq', 0) == resource.data.get('folio_seq', 0)
                    && tiemposOk(request.resource.data)
                    && firmaOk(request.resource.data, 'firma_m')
                    && firmaOk(request.resource.data, 'firma_l')
                    // Cada firma solo la puede producir su dueño real:
                    // `firma_l` (aprobación) es exclusiva del admin, y `firma_m`
                    // solo la crea el muestrista. El admin sí puede LIMPIARLA
                    // (ponerla en null) al rechazar una ficha, pero no fabricarla.
                    && (request.resource.data.get('firma_l', null) == resource.data.get('firma_l', null)
                        || esAdmin())
                    && (request.resource.data.get('firma_m', null) == resource.data.get('firma_m', null)
                        || esMuestristaActual()
                        || request.resource.data.get('firma_m', null) == null)
                    // Una ficha aprobada solo puede reabrirse a pendiente_lety
                    && (resource.data.estado != 'aprobado'
                        || request.resource.data.estado == 'pendiente_lety')
                    // Una ficha firmada (pendiente) solo se aprueba o se rechaza
                    && (resource.data.estado != 'pendiente_lety'
                        || request.resource.data.estado in ['aprobado', 'correccion'])
                    // El estado 'aprobado' solo puede llegar desde 'pendiente_lety'
                    && (request.resource.data.estado != 'aprobado'
                        || resource.data.estado == 'pendiente_lety')
                    // Los estados firmados exigen su firma correspondiente
                    && (request.resource.data.estado != 'pendiente_lety'
                        || (('firma_m' in request.resource.data) && request.resource.data.firma_m is string))
                    && (request.resource.data.estado != 'aprobado'
                        || (('firma_l' in request.resource.data) && request.resource.data.firma_l is string))
                    // Identidad: mientras la ficha está en manos del muestrista
                    // (activo/pausado/correccion) solo su dueño real la edita;
                    // en cuanto pasa a manos de Lety (pendiente_lety/aprobado)
                    // solo el admin puede tocarla (aprobar/rechazar/reabrir).
                    // Esto es lo que cierra el hallazgo crítico: antes cualquiera
                    // podía fabricar firma_m/firma_l sin ser el muestrista/admin real.
                    && (
                         (esMuestristaActual() && miEmpleadoId() == resource.data.id_muestrista
                          && resource.data.estado in ['activo', 'pausado', 'correccion'])
                         || (esAdmin() && resource.data.estado in ['pendiente_lety', 'aprobado'])
                       );
      // ── Lety rellena la OT/PO que no existían cuando nació la ficha.
      // `createCap` copia esos datos del desarrollo al crear la captura, así
      // que una ficha empezada antes de que se generara la OT se quedaría sin
      // ella para siempre (y el CSV saldría incompleto). Solo de vacío a
      // lleno, sin tocar ningún otro campo ni el estado.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ot', 'po', 'agujado'])
                    && completaTexto('ot', 40) && completaTexto('po', 40)
                    && completaTexto('agujado', 10);
      allow delete: if false;
    }

    // ── pausas: el muestrista PIDE, Lety AUTORIZA ──
    //
    // Antes el muestrista paraba su propio cronómetro cuando quería y nadie se
    // enteraba. Lety pidió que cada pausa se solicite con su causa y que ella
    // decida — y que el desglose quede en la tarea.
    //
    // POR QUÉ UNA SUBCOLECCIÓN Y NO UN CAMPO EN LA CAPTURA:
    //   · Un solo campo se pisa con la siguiente solicitud y borra el historial
    //     que es justo lo que se quiere conservar.
    //   · Las reglas de /capturas solo dejan al admin escribir cuando la ficha
    //     ya está firmada (pendiente_lety/aprobado). Sobre una ficha ACTIVA el
    //     admin no puede escribir, así que la aprobación sería rechazada.
    //     Aquí cada quien escribe su parte de un documento propio.
    //
    // TODOS los sellos de tiempo son `request.time` (hora del servidor): si el
    // cliente pudiera declararlos, un TM se podría alargar a voluntad.
    //
    // El cronómetro NO se detiene al pedir la pausa — decisión del dueño: el
    // TM cuenta desde que Lety aprueba (`inicio_tm`), no desde la solicitud.
    match /capturas/{capId}/pausas/{pausaId} {
      function miCaptura() {
        return get(/databases/$(database)/documents/capturas/$(capId)).data.id_muestrista == miEmpleadoId();
      }
      function causaValida(c) {
        return c in ['maquina', 'color', 'material', 'lety', 'cliente', 'falla', 'descanso', 'personal'];
      }
      // Lety necesita verlas todas para autorizarlas; el muestrista, las suyas.
      allow read: if esAdmin() || (esMuestristaActual() && miCaptura());

      // El dueño de la ficha solicita. Nace SIEMPRE pendiente: no puede
      // auto-aprobarse.
      allow create: if esMuestristaActual() && miCaptura()
                    && request.resource.data.keys().hasOnly(['estado', 'causa', 'solicitada_en', 'solicitada_por'])
                    && request.resource.data.estado == 'pendiente'
                    && causaValida(request.resource.data.causa)
                    && request.resource.data.solicitada_en == request.time
                    && request.resource.data.solicitada_por == miEmpleadoId();

      allow update: if
        // ── Lety decide. `inicio_tm` lo pone el servidor: es el instante en
        // que empieza a contar el tiempo muerto.
        (esAdmin()
         && resource.data.estado == 'pendiente'
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['estado', 'decidida_en', 'decidida_por', 'inicio_tm'])
         && request.resource.data.estado in ['aprobada', 'rechazada']
         && request.resource.data.decidida_en == request.time
         && request.resource.data.decidida_por == miEmpleadoId()
         && (request.resource.data.estado != 'aprobada'
             || request.resource.data.inicio_tm == request.time)
         && (request.resource.data.estado != 'rechazada'
             || !('inicio_tm' in request.resource.data)))
        // ── El muestrista cierra su pausa cuando vuelve al trabajo.
        || (esMuestristaActual() && miCaptura()
            && resource.data.estado == 'aprobada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fin_tm'])
            && request.resource.data.estado == 'finalizada'
            && request.resource.data.fin_tm == request.time)
        // ── El muestrista retira una solicitud que ya no aplica. Pasa al
        // firmar la ficha: si la pausa quedara viva, seguiría en la cola de
        // Lety y podría revivir con su hora original si la ficha se reabre
        // para corrección, inflando el tiempo muerto sin que nadie la pidiera.
        || (esMuestristaActual() && miCaptura()
            && resource.data.estado == 'pendiente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fin_tm'])
            && request.resource.data.estado == 'cancelada'
            && request.resource.data.fin_tm == request.time);
      // Nadie borra una pausa: es el registro de en qué se fue el tiempo.
      allow delete: if false;
    }

    // ── contadores: folios consecutivos (doc 'capturas' = { seq }) ──
    // Solo se acepta el siguiente consecutivo exacto: sin saltos ni retrocesos
    // Solo el muestrista escribe aquí: es quien crea fichas. Lety nunca crea
    // capturas, así que no necesita tocar el contador.
    // LIMITACIÓN CONOCIDA: un muestrista podría incrementar el contador sin
    // crear la captura correspondiente y quemar folios (no rompe la unicidad,
    // solo deja huecos en la serie). Cerrarlo requiere un puntero cruzado
    // `last_cap_id` entre contador y captura, que no se implementó porque no
    // hay forma de probarlo en local (el emulador de Firestore necesita Java,
    // que no está instalado) y toca la ruta crítica de creación de fichas.
    match /contadores/{docId} {
      allow read: if tieneUsuarioActivo();
      allow create: if esMuestristaActual()
                    && docId == 'capturas'
                    && request.resource.data.keys().hasOnly(['seq'])
                    && request.resource.data.seq is int
                    && request.resource.data.seq == 1;
      allow update: if esMuestristaActual()
                    && docId == 'capturas'
                    && request.resource.data.keys().hasOnly(['seq'])
                    && request.resource.data.seq is int
                    && request.resource.data.seq == resource.data.seq + 1;
      allow delete: if false;
    }

    // ── catalogo: códigos importados desde Excel por Lety para autollenar
    // la pantalla Asignar. Doc id = código normalizado (mayúsculas, sin
    // espacios ni '/'), así el autollenado es un point-read directo.
    // El cliente trunca a 200 caracteres (limpiaTexto); el margen a 600 evita
    // que una descripción con muchos acentos rebote el lote entero si size()
    // se evalúa en bytes UTF-8 en vez de caracteres.
    function textoCat(data, campo) {
      return campo in data && data[campo] is string && data[campo].size() <= 600;
    }
    match /catalogo/{codigo} {
      // Solo Lety usa el catálogo (autollenado/import en admin.js); el
      // muestrista nunca lo lee. Lectura amplia exponía todos los códigos,
      // modelos y clientes de todos los pedidos a cualquier cuenta activa.
      allow read: if esAdmin();
      allow create, update: if esAdmin()
                    && request.resource.data.keys().hasOnly([
                         'codigo', 'descripcion', 'modelo', 'cliente', 'pares_requeridos',
                         'tipo_pack', 'genero', 'talla', 'tipo_producto', 'codigo_quini', 'actualizado'])
                    && request.resource.data.codigo == codigo
                    && codigo.size() > 0 && codigo.size() <= 60
                    && codigo.matches('^[A-Z0-9][A-Z0-9._-]*$')
                    && textoCat(request.resource.data, 'descripcion')
                    && textoCat(request.resource.data, 'modelo')
                    && textoCat(request.resource.data, 'cliente')
                    && textoCat(request.resource.data, 'pares_requeridos')
                    && textoCat(request.resource.data, 'tipo_pack')
                    && textoCat(request.resource.data, 'genero')
                    && textoCat(request.resource.data, 'talla')
                    && textoCat(request.resource.data, 'tipo_producto')
                    && textoCat(request.resource.data, 'codigo_quini')
                    && request.resource.data.actualizado == request.time;
      allow delete: if esAdmin();
    }

    // ── catalogo_meta/info: última importación. Su importId es lo que
    // invalida la caché de autollenado en todos los dispositivos.
    match /catalogo_meta/{docId} {
      // Mismo criterio que catalogo/: solo lo consume watchCatalogo() en
      // admin.js (pantalla de Lety).
      allow read: if esAdmin();
      allow write: if esAdmin()
                   && docId == 'info'
                   && request.resource.data.keys().hasOnly(['filas_importadas', 'total_archivo', 'fuente', 'importId', 'actualizado'])
                   && request.resource.data.filas_importadas is int
                   && request.resource.data.filas_importadas >= 0
                   && request.resource.data.total_archivo is int
                   && request.resource.data.total_archivo >= 0
                   && request.resource.data.fuente is string
                   && request.resource.data.fuente.size() <= 120
                   && request.resource.data.importId is string
                   && request.resource.data.importId.size() <= 40
                   && request.resource.data.actualizado == request.time;
    }

    // ── _ping: test de conectividad (write de prueba al arrancar sesión) ──
    match /_ping/{docId} {
      allow read: if tieneUsuarioActivo();
      allow write: if tieneUsuarioActivo()
                   && docId == 'test'
                   && request.resource.data.keys().hasOnly(['ts'])
                   && request.resource.data.ts is number;
    }

    // ── Todo lo demás (incluye la vieja colección `pines`, ya retirada):
    // bloqueado ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
