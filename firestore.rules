rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Reglas de producción — Sistema de Muestristas · Deportivos Quini
//
// Identidad: Firebase Authentication (Email/Password), una cuenta fija por
// empleado. Cada cuenta se mapea a su rol de negocio vía el documento de
// SOLO LECTURA usuarios/{authUid} = { empleadoId, rol }, creado una sola vez
// a mano desde la consola de Firebase — nunca lo escribe el cliente, para
// que nadie pueda auto-asignarse un rol.
//
// El login en la app sigue siendo "elige tu ícono + tu PIN de 6 dígitos":
// el PIN es literalmente la contraseña de esa cuenta de Firebase Auth, así
// que la verificación ya no pasa por Firestore ni por el cliente — la hace
// el servidor de Identity Platform de Google (con su propio rate limiting
// contra fuerza bruta). Antes de esta versión, la identidad se declaraba
// en el propio payload del cliente (uid en la ruta del documento o en
// request.resource.data) y no había forma de verificarla — cualquiera con
// el SDK de Firestore y el apiKey público podía leer/escribir como
// cualquier usuario. Con request.auth.uid verificado por Google, eso ya
// no es posible.
//
// ALCANCE DE CADA ROL (definido 2026-08-07):
//   · Muestrista — ve ÚNICAMENTE lo suyo: los desarrollos donde él es el
//     `asignado_a` y las capturas donde él es el `id_muestrista`. No ve el
//     trabajo de su compañero ni el dashboard comparativo.
//   · Admin (Lety) — ve todo: asigna, revisa, aprueba y es la única que abre
//     el dashboard, el catálogo y las exportaciones.
//
//   Por qué NO se copió el modelo de la app hermana (captura-mecanicos):
//   allá las incidencias son una cola compartida y cualquier mecánico debe
//   poder verlas todas para tomar la que le toque. Aquí no hay cola: Lety
//   asigna nominalmente, así que la lectura amplia no compraba nada y solo
//   exponía el trabajo ajeno.
//
// LA ASIGNACIÓN ES PERMANENTE. `asignado_a` (desarrollos) e `id_muestrista`
// (capturas) son inmutables, y la segmentación de lectura de arriba depende
// de eso. Si algún día se quiere permitir reasignar o cubrir una ausencia,
// NO basta con volver mutable `asignado_a`: el dueño anterior conservaría
// sus capturas y el nuevo vería el desarrollo sin poder continuarlas, y se
// podría duplicar la ficha de una variante ya capturada. Ese traspaso tiene
// que resolver las capturas abiertas y preservar la autoría histórica (las
// métricas por muestrista se calculan sobre `id_muestrista`).
//
// Despliegue:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ──
    function autenticado() {
      return request.auth != null;
    }
    function usuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    // Baja de personal sin borrar la cuenta: `activo: false` en el perfil
    // corta el acceso en la siguiente petición, sin esperar a que expire el
    // ID token. El default es `true` a propósito — los tres perfiles actuales
    // se crearon a mano antes de que existiera el campo y `usuarios` tiene
    // `allow write: if false`, así que no se pueden migrar desde la app: un
    // default `false` dejaría fuera a todo el mundo en el instante del deploy.
    // Campo ausente = perfil legacy = activo. Si se llega a poblar `activo`
    // en los tres perfiles desde la consola, conviene cambiar el default a
    // `false` (más seguro). IMPORTANTE al desactivar desde la consola de
    // Firebase: el campo debe ser de tipo booleano, no el string "false" —
    // un valor mal tipado también bloquea el acceso (falla el `is bool`),
    // pero es mucho más confuso de diagnosticar que un rechazo limpio.
    function activoOk() {
      return usuarioDoc().data.get('activo', true) is bool
        && usuarioDoc().data.get('activo', true) == true;
    }
    function tieneUsuarioActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && activoOk();
    }
    function miEmpleadoId() {
      return usuarioDoc().data.empleadoId;
    }
    function esAdmin() {
      return tieneUsuarioActivo() && usuarioDoc().data.rol == 'admin';
    }
    function esMuestristaActual() {
      return tieneUsuarioActivo() && usuarioDoc().data.rol == 'muestrista';
    }

    // ── Helpers de datos (validación de forma, igual que antes) ──
    function esMuestristaId(id) {
      return id in ['israel', 'jesus'];
    }
    function estadoCapturaValido(e) {
      return e in ['activo', 'pausado', 'pendiente_lety', 'correccion', 'aprobado'];
    }
    function estadoDesarrolloValido(e) {
      return e in ['pendiente', 'en_proceso'];
    }
    // Firma: ausente, null, o data-URL PNG bien formado (la app solo
    // renderiza este formato; bloquea payloads de XSS almacenado)
    function firmaOk(data, campo) {
      return !(campo in data) || data[campo] == null
        || (data[campo] is string
            && data[campo].size() < 300000
            && data[campo].matches('data:image/png;base64,[A-Za-z0-9+/=]+'));
    }
    // Tiempos coherentes: números no negativos, TM nunca mayor que el bruto
    function tiemposOk(data) {
      return data.elapsed_seg is number && data.tm_seg is number
        && data.elapsed_seg >= 0 && data.tm_seg >= 0
        && data.tm_seg <= data.elapsed_seg
        && (!('tm_causas' in data) || data.tm_causas is map);
    }

    // ── usuarios: mapa authUid -> {empleadoId, rol}. Cada cuenta solo lee
    // su propio doc; la creación/edición es manual desde la consola.
    match /usuarios/{authUid} {
      allow read: if autenticado() && request.auth.uid == authUid;
      allow write: if false;
    }

    // ── desarrollos: tareas que Lety asigna ──
    match /desarrollos/{devId} {
      // Lety ve todos; cada muestrista solo los suyos. Como las reglas NO
      // filtran, toda consulta de lista del muestrista debe traer su propio
      // where('asignado_a','==',...) o Firestore la rechaza entera
      // (ver muestrista.js y captura.js).
      allow read: if esAdmin()
                  || (esMuestristaActual() && resource.data.asignado_a == miEmpleadoId());
      allow create: if esAdmin()
                    && request.resource.data.modelo is string
                    && request.resource.data.modelo.size() > 0
                    && esMuestristaId(request.resource.data.asignado_a)
                    && estadoDesarrolloValido(request.resource.data.estado)
                    && !('tipo_complejidad' in request.resource.data)
                    && existsAfter(/databases/$(database)/documents/desarrollos_privado/$(devId))
                    && request.resource.data.variantes is list
                    && request.resource.data.variantes.size() > 0
                    && request.resource.data.variante_codigos is list
                    && request.resource.data.variante_codigos.size() > 0
                    && request.resource.data.creado_por == miEmpleadoId();
      // La app solo cambia `estado` (Lety al asignar; el muestrista al
      // iniciar una captura); los campos sensibles son inmutables para todos.
      // Además, solo el admin o el muestrista dueño real de la tarea puede
      // tocarla (mismo patrón que capturas más abajo).
      allow update: if (esAdmin() || (esMuestristaActual() && miEmpleadoId() == resource.data.asignado_a))
                    && estadoDesarrolloValido(request.resource.data.estado)
                    && request.resource.data.get('tipo_complejidad', '') == resource.data.get('tipo_complejidad', '')
                    && request.resource.data.get('asignado_a', '') == resource.data.get('asignado_a', '')
                    && request.resource.data.get('variantes', []) == resource.data.get('variantes', [])
                    && request.resource.data.get('variante_codigos', []) == resource.data.get('variante_codigos', [])
                    && request.resource.data.get('creado_por', '') == resource.data.get('creado_por', '');
      allow delete: if false;
    }

    // ── desarrollos_privado: datos exclusivos de admin (tipo_complejidad).
    // Documento espejo 1:1 de desarrollos/{devId}, mismo id, creado junto
    // con el público en el mismo batch (ver admin.js asignar()).
    match /desarrollos_privado/{devId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.data.keys().hasOnly(['tipo_complejidad'])
                    && request.resource.data.tipo_complejidad in ['A', 'B', 'C']
                    && existsAfter(/databases/$(database)/documents/desarrollos/$(devId));
      allow update, delete: if false;
    }

    // ── capturas: fichas prácticas (una por variante) ──
    match /capturas/{capId} {
      // Misma segmentación que desarrollos: Lety todo, el muestrista solo sus
      // fichas. El dashboard comparativo por muestrista es exclusivo de Lety.
      allow read: if esAdmin()
                  || (esMuestristaActual() && resource.data.id_muestrista == miEmpleadoId());
      allow create: if esMuestristaActual()
                    && request.resource.data.id_muestrista == miEmpleadoId()
                    && request.resource.data.id_desarrollo is string
                    && request.resource.data.codigo_variante is string
                    && request.resource.data.estado == 'activo'
                    && tiemposOk(request.resource.data)
                    && firmaOk(request.resource.data, 'firma_m')
                    && firmaOk(request.resource.data, 'firma_l')
                    // Folio consecutivo obligatorio, amarrado al contador que
                    // la MISMA transacción deja actualizado (getAfter)
                    && request.resource.data.folio is string
                    && request.resource.data.folio.matches('^FP-[0-9]{5,}$')
                    && request.resource.data.folio_seq is int
                    && request.resource.data.folio_seq > 0
                    && getAfter(/databases/$(database)/documents/contadores/capturas).data.seq == request.resource.data.folio_seq
                    // Cierra el hueco de atomicidad: exige que el contador
                    // haya estado exactamente en folio_seq-1 ANTES de esta
                    // operación (o no existiera, si folio_seq==1) — no basta
                    // con que el valor final (getAfter) cuadre.
                    && ((!exists(/databases/$(database)/documents/contadores/capturas) && request.resource.data.folio_seq == 1)
                        || (exists(/databases/$(database)/documents/contadores/capturas)
                            && get(/databases/$(database)/documents/contadores/capturas).data.seq == request.resource.data.folio_seq - 1))
                    // El dueño de la captura debe ser el mismo empleado
                    // asignado al desarrollo, y la variante debe pertenecer
                    // realmente a ese desarrollo (evita fichas fraudulentas)
                    && get(/databases/$(database)/documents/desarrollos/$(request.resource.data.id_desarrollo)).data.asignado_a == miEmpleadoId()
                    && request.resource.data.codigo_variante in get(/databases/$(database)/documents/desarrollos/$(request.resource.data.id_desarrollo)).data.variante_codigos;
      allow update: if estadoCapturaValido(request.resource.data.estado)
                    // El dueño, el desarrollo de origen y la variante no se reasignan
                    && request.resource.data.id_muestrista == resource.data.id_muestrista
                    && request.resource.data.id_desarrollo == resource.data.id_desarrollo
                    && request.resource.data.get('codigo_variante', '') == resource.data.get('codigo_variante', '')
                    // El folio no se puede cambiar ni borrar una vez asignado
                    && request.resource.data.get('folio', '') == resource.data.get('folio', '')
                    && request.resource.data.get('folio_seq', 0) == resource.data.get('folio_seq', 0)
                    && tiemposOk(request.resource.data)
                    && firmaOk(request.resource.data, 'firma_m')
                    && firmaOk(request.resource.data, 'firma_l')
                    // Cada firma solo la puede producir su dueño real:
                    // `firma_l` (aprobación) es exclusiva del admin, y `firma_m`
                    // solo la crea el muestrista. El admin sí puede LIMPIARLA
                    // (ponerla en null) al rechazar una ficha, pero no fabricarla.
                    && (request.resource.data.get('firma_l', null) == resource.data.get('firma_l', null)
                        || esAdmin())
                    && (request.resource.data.get('firma_m', null) == resource.data.get('firma_m', null)
                        || esMuestristaActual()
                        || request.resource.data.get('firma_m', null) == null)
                    // Una ficha aprobada solo puede reabrirse a pendiente_lety
                    && (resource.data.estado != 'aprobado'
                        || request.resource.data.estado == 'pendiente_lety')
                    // Una ficha firmada (pendiente) solo se aprueba o se rechaza
                    && (resource.data.estado != 'pendiente_lety'
                        || request.resource.data.estado in ['aprobado', 'correccion'])
                    // El estado 'aprobado' solo puede llegar desde 'pendiente_lety'
                    && (request.resource.data.estado != 'aprobado'
                        || resource.data.estado == 'pendiente_lety')
                    // Los estados firmados exigen su firma correspondiente
                    && (request.resource.data.estado != 'pendiente_lety'
                        || (('firma_m' in request.resource.data) && request.resource.data.firma_m is string))
                    && (request.resource.data.estado != 'aprobado'
                        || (('firma_l' in request.resource.data) && request.resource.data.firma_l is string))
                    // Identidad: mientras la ficha está en manos del muestrista
                    // (activo/pausado/correccion) solo su dueño real la edita;
                    // en cuanto pasa a manos de Lety (pendiente_lety/aprobado)
                    // solo el admin puede tocarla (aprobar/rechazar/reabrir).
                    // Esto es lo que cierra el hallazgo crítico: antes cualquiera
                    // podía fabricar firma_m/firma_l sin ser el muestrista/admin real.
                    && (
                         (esMuestristaActual() && miEmpleadoId() == resource.data.id_muestrista
                          && resource.data.estado in ['activo', 'pausado', 'correccion'])
                         || (esAdmin() && resource.data.estado in ['pendiente_lety', 'aprobado'])
                       );
      allow delete: if false;
    }

    // ── contadores: folios consecutivos (doc 'capturas' = { seq }) ──
    // Solo se acepta el siguiente consecutivo exacto: sin saltos ni retrocesos
    // Solo el muestrista escribe aquí: es quien crea fichas. Lety nunca crea
    // capturas, así que no necesita tocar el contador.
    // LIMITACIÓN CONOCIDA: un muestrista podría incrementar el contador sin
    // crear la captura correspondiente y quemar folios (no rompe la unicidad,
    // solo deja huecos en la serie). Cerrarlo requiere un puntero cruzado
    // `last_cap_id` entre contador y captura, que no se implementó porque no
    // hay forma de probarlo en local (el emulador de Firestore necesita Java,
    // que no está instalado) y toca la ruta crítica de creación de fichas.
    match /contadores/{docId} {
      allow read: if tieneUsuarioActivo();
      allow create: if esMuestristaActual()
                    && docId == 'capturas'
                    && request.resource.data.keys().hasOnly(['seq'])
                    && request.resource.data.seq is int
                    && request.resource.data.seq == 1;
      allow update: if esMuestristaActual()
                    && docId == 'capturas'
                    && request.resource.data.keys().hasOnly(['seq'])
                    && request.resource.data.seq is int
                    && request.resource.data.seq == resource.data.seq + 1;
      allow delete: if false;
    }

    // ── catalogo: códigos importados desde Excel por Lety para autollenar
    // la pantalla Asignar. Doc id = código normalizado (mayúsculas, sin
    // espacios ni '/'), así el autollenado es un point-read directo.
    // El cliente trunca a 200 caracteres (limpiaTexto); el margen a 600 evita
    // que una descripción con muchos acentos rebote el lote entero si size()
    // se evalúa en bytes UTF-8 en vez de caracteres.
    function textoCat(data, campo) {
      return campo in data && data[campo] is string && data[campo].size() <= 600;
    }
    match /catalogo/{codigo} {
      allow read: if tieneUsuarioActivo();
      allow create, update: if esAdmin()
                    && request.resource.data.keys().hasOnly([
                         'codigo', 'descripcion', 'modelo', 'cliente', 'pares_requeridos',
                         'tipo_pack', 'genero', 'talla', 'tipo_producto', 'codigo_quini', 'actualizado'])
                    && request.resource.data.codigo == codigo
                    && codigo.size() > 0 && codigo.size() <= 60
                    && codigo.matches('^[A-Z0-9][A-Z0-9._-]*$')
                    && textoCat(request.resource.data, 'descripcion')
                    && textoCat(request.resource.data, 'modelo')
                    && textoCat(request.resource.data, 'cliente')
                    && textoCat(request.resource.data, 'pares_requeridos')
                    && textoCat(request.resource.data, 'tipo_pack')
                    && textoCat(request.resource.data, 'genero')
                    && textoCat(request.resource.data, 'talla')
                    && textoCat(request.resource.data, 'tipo_producto')
                    && textoCat(request.resource.data, 'codigo_quini')
                    && request.resource.data.actualizado == request.time;
      allow delete: if esAdmin();
    }

    // ── catalogo_meta/info: última importación. Su importId es lo que
    // invalida la caché de autollenado en todos los dispositivos.
    match /catalogo_meta/{docId} {
      allow read: if tieneUsuarioActivo();
      allow write: if esAdmin()
                   && docId == 'info'
                   && request.resource.data.keys().hasOnly(['filas_importadas', 'total_archivo', 'fuente', 'importId', 'actualizado'])
                   && request.resource.data.filas_importadas is int
                   && request.resource.data.filas_importadas >= 0
                   && request.resource.data.total_archivo is int
                   && request.resource.data.total_archivo >= 0
                   && request.resource.data.fuente is string
                   && request.resource.data.fuente.size() <= 120
                   && request.resource.data.importId is string
                   && request.resource.data.importId.size() <= 40
                   && request.resource.data.actualizado == request.time;
    }

    // ── _ping: test de conectividad (write de prueba al arrancar sesión) ──
    match /_ping/{docId} {
      allow read: if tieneUsuarioActivo();
      allow write: if tieneUsuarioActivo()
                   && docId == 'test'
                   && request.resource.data.keys().hasOnly(['ts'])
                   && request.resource.data.ts is number;
    }

    // ── Todo lo demás (incluye la vieja colección `pines`, ya retirada):
    // bloqueado ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
